digraph G { graph [rankdir=LR, bgcolor="white", pad=.4, nodesep=.5, ranksep=.8]; node [shape=box, style="rounded,filled", fillcolor="#EAF2FA", color="#4B6584", fontname="DejaVu Sans", fontsize=12, margin=".22,.15"]; edge [color="#526779", fontname="DejaVu Sans", fontsize=10]; Client [label="Cliente / API",fillcolor="#E5F4E8"]; Order [label="Order Service\nBanco de pedidos"]; Saga [label="Saga Orchestrator\nBanco de estado",fillcolor="#FFF1D6"]; Broker [label="Barramento de mensagens",shape=cylinder,fillcolor="#F0EAFB"]; Inventory [label="Inventory Service\nBanco de estoque"]; Payment [label="Payment Service\nBanco de pagamentos"]; Gateway [label="Gateway financeiro",fillcolor="#E5F4E8"]; Client -> Order [label="HTTP"]; Order -> Saga [label="inicia Saga"]; Saga -> Broker [dir=both,label="comandos / respostas"]; Broker -> Inventory [dir=both]; Broker -> Payment [dir=both]; Broker -> Order [dir=both]; Payment -> Gateway [dir=both,label="API externa"]; }